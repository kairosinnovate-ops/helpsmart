# HelpSmart environment template. Copy to .env.local for local development.
# Never commit real values. In staging/production, secrets come from Secret Manager (see apphosting.yaml).

# --- App ---
# development | test | staging | production
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Firebase web config (public, but per-environment) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-helpsmart.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-helpsmart
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-helpsmart.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local emulators (development only) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-helpsmart

# --- Firebase Admin outside Google Cloud (leave empty on App Hosting / Cloud Run, which use ADC) ---
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Identity verification ---
# disabled    : verification unavailable (safe default)
# dev_fixture : local simulated identity, ONLY allowed when APP_ENV is development or test.
#               The app refuses to start with this value in staging or production.
# fayda_oidc  : official Fayda OIDC. Requires values issued during Fayda partner onboarding.
IDENTITY_MODE=dev_fixture

# The values below are NOT known yet. They must come from the official Fayda (NIDP) onboarding
# for HelpSmart's approved relying-party registration. Do not guess them.
# FAYDA_ISSUER=
# FAYDA_CLIENT_ID=
# FAYDA_REDIRECT_URI=https://<your-domain>/api/identity/callback
# FAYDA_CLIENT_PRIVATE_JWK=        # secret: private JWK for private_key_jwt
# FAYDA_CLIENT_ASSERTION_ALG=RS256
# FAYDA_SCOPES=openid profile
# FAYDA_ACR_VALUES=
# FAYDA_CLAIMS_REQUEST=
# FAYDA_UI_LOCALES=
# FAYDA_USERINFO_DECRYPTION_JWK=   # secret: only if userinfo is returned as JWE
# FAYDA_EXPECTED_ID_TOKEN_ALGS=RS256,PS256,ES256
# FAYDA_RETAINED_CLAIMS=name,birthdate,gender

# --- Application-layer encryption for identity data (32 random bytes, base64). Required in production. ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HMAC_KEY=

# --- Payments (no gateway is integrated yet; cash and bank transfer only) ---
PAYMENT_GATEWAYS_ENABLED=
# CHAPA_WEBHOOK_SECRET=

# --- Maps (optional). Without this the map view shows an "unavailable" note. ---
# NEXT_PUBLIC_MAP_PROVIDER=
