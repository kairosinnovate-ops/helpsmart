{
  "name": "helpsmart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-helpsmart --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "seed": "node --conditions=react-server --import tsx scripts/seed-dev.ts",
    "seed:demo": "node --conditions=react-server --import tsx scripts/seed-dev.ts --demo",
    "admin:grant": "node --conditions=react-server --import tsx scripts/provision-admin.ts",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-helpsmart \"vitest run tests/rules\"",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-helpsmart \"vitest run tests/integration\"",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run test:integration"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
